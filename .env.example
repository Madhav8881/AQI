# Environment Configuration Template for Spatiotemporal AQI Project
# Copy this file to .env and configure as needed:
#   cp .env.example .env
# Note: .env is ignored by git to protect credentials and local configurations.

# Optional: API Key for XKDR Forum Air Quality Database (Continuous Ambient Air Quality Monitoring)
# If left unset, default demo credentials are used for testing.
XKDR_API_KEY=your_api_key_here

# Optional: Preferred PyTorch compute device override ('cuda', 'cpu')
# DEVICE=cpu

